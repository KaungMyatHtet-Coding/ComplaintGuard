rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeRole(role) {
      return signedIn()
        && currentUser().data.active == true
        && currentUser().data.role == role;
    }

    function isManager() {
      return activeRole('manager');
    }

    function isAdmin() {
      return activeRole('admin');
    }

    function ownsTicket(ticket) {
      return signedIn() && ticket.data.customerId == request.auth.uid;
    }

    function staffForTicket(ticket) {
      return activeRole('staff')
        && currentUser().data.departmentId is string
        && currentUser().data.departmentId == ticket.data.departmentId;
    }

    function parentTicket(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId));
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Profile and authorization changes require a trusted backend. This avoids
      // client escalation through role, departmentId, or active fields.
      allow create, update, delete: if false;
    }

    match /departments/{departmentId} {
      // Preserve V1 department reads while keeping V2 private metadata behind
      // the trusted Admin API.
      allow read: if signedIn()
        && (!('taxonomyVersion' in resource.data) || resource.data.taxonomyVersion != 'v2');
      allow create, update, delete: if false;

      match /members/{staffId} {
        allow read, write: if false;
      }

      match /queueState/{queueStateId} {
        allow read, write: if false;
      }
    }

    // V2 directory, historical identity, idempotency, and audit documents are
    // server-managed. No browser role may read or mutate these collections.
    match /staffProfiles/{staffId} {
      allow read, write: if false;
    }

    match /staffIdentities/{identityId} {
      allow read, write: if false;
    }

    match /v2FoundationActions/{actionId} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read, write: if false;
    }

    match /tickets/{ticketId} {
      // Ticket reads use the trusted Customer/Staff/Manager API projections.
      // Raw client reads remain denied for every role.
      allow read: if false;

      // Creation and controlled changes pass through trusted server code for
      // ownership binding, PII redaction, lifecycle checks, and audit writes.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /dashboardSummaries/{summaryId} {
      allow read: if isManager() || isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
