# Explicitly allow future small reviewed samples/mappings when intentionally added
!data/mapping/*.csv
!data/mapping/*.json
!data/processed/*.csv
!data/processed/*.parquet
!data/processed/*.json
!data/eda/**/*.csv
!data/eda/**/*.json
