# Placeholder configuration only. Copy to a local ignored environment file.
# Never place real credentials, service-account JSON, or secrets in this file.

# Public Firebase web configuration for the future frontend.
# Keep Firebase on the Spark plan and do not attach a billing account.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_web_app_id

# Future public URL of the zero-cost FastAPI inference service.
NEXT_PUBLIC_ML_API_URL=http://localhost:8000

# Server settings that are safe as placeholders.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
MODEL_PATH=models/complaintguard_v1.joblib
MAX_COMPLAINT_LENGTH=5000
